# Copy to config/config_staging.yaml
api:
  base_url: "https://api-staging.example.com/v1"
  graphql_endpoint: "https://api-staging.example.com/graphql"
  timeout: 30
  graphql_fetch_schema: false

web:
  base_url: "https://web-staging.example.com"
  browser: "chromium"
  headless: true
  record_trace: true
  record_video: false

database:
  type: "postgresql"
  host: "staging-db.example.com"
  port: 5432
  name: "staging_db"
  user: "staging_user"
  password: ""

logging:
  level: "INFO"
  file: "logs/automation-staging.log"

mobile:
  appium_server_url: "http://localhost:4723"
